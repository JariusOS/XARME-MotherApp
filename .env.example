# Everything is optional. Missing values switch that integration to SIMULATED mode.

# --- X (Twitter) OAuth 2.0 user login (PKCE). Create an app at developer.x.com.
X_CLIENT_ID=
X_CLIENT_SECRET=            # only for confidential clients
X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback

# --- X API app-only bearer: verified post metrics + discover search
X_BEARER_TOKEN=
X_DISCOVER_QUERY=-is:retweet -is:reply lang:en has:media

# --- Database. Unset = embedded Postgres (PGlite) stored in ./.data
DATABASE_URL=

# --- Sessions (32+ chars). Required in production.
SESSION_SECRET=

# --- Solana
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# --- 6-hourly impression tracking (Vercel cron sends: Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# Seed 320 simulated users on the leaderboards (default: on when X data is simulated)
SEED_SIMULATED=
